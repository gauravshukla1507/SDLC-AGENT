{
  "name": "agentic-sdlc",
  "displayName": "Agentic SDLC: AI Delivery Company",
  "description": "Give it a requirements document and an AI delivery company inside VS Code builds the application, on any technology. An orchestrator with an org chart of Claude-powered agents (requirements, architect, developer, tester, reviewer, security, release) detects your stack, briefs the agents with its conventions, verifies every change with the stack's own build/analysis/test tools, enforces budgets and human approvals, and keeps a full audit trail.",
  "version": "1.2.0",
  "publisher": "zenlabs",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Testing",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai agents",
    "multi-agent",
    "orchestration",
    "sdlc",
    "claude",
    "code review",
    "testing",
    "devops",
    "java",
    "dotnet",
    "node",
    "typescript",
    "python",
    "go",
    "salesforce"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenticSdlc",
          "title": "Agentic SDLC",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agenticSdlc": [
        {
          "id": "agenticSdlc.projects",
          "name": "Projects"
        },
        {
          "id": "agenticSdlc.approvals",
          "name": "Approvals"
        },
        {
          "id": "agenticSdlc.company",
          "name": "Org chart"
        },
        {
          "id": "agenticSdlc.stacks",
          "name": "Stack & verification"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agenticSdlc.projects",
        "contents": "Give the agent team a requirements document (BRD, PRD, user stories in .md, .docx or .pdf). It builds the application in this repository or in a new folder, on whatever stack fits.\n[Build application from requirements document](command:agenticSdlc.buildFromDocument)\n[Describe a change](command:agenticSdlc.runRequest)\n[Check setup](command:agenticSdlc.checkSetup)"
      },
      {
        "view": "agenticSdlc.approvals",
        "contents": "Nothing is waiting for you. Hiring, releases, budget overrides, gateway actions and escalations appear here."
      },
      {
        "view": "agenticSdlc.company",
        "contents": "The org chart appears after your first run.\n[Set up company\u2026](command:agenticSdlc.initCompany)"
      }
    ],
    "commands": [
      {
        "command": "agenticSdlc.buildFromDocument",
        "title": "Build application from requirements document\u2026",
        "category": "Agentic SDLC",
        "icon": "$(rocket)"
      },
      {
        "command": "agenticSdlc.checkSetup",
        "title": "Check setup (Claude subscription / API key, stack tools)",
        "category": "Agentic SDLC",
        "icon": "$(checklist)"
      },
      {
        "command": "agenticSdlc.signInClaude",
        "title": "Sign in to Claude (use my subscription)",
        "category": "Agentic SDLC",
        "icon": "$(account)"
      },
      {
        "command": "agenticSdlc.runRequest",
        "title": "Describe a change\u2026",
        "category": "Agentic SDLC",
        "icon": "$(comment)"
      },
      {
        "command": "agenticSdlc.runSelection",
        "title": "Run on selected text",
        "category": "Agentic SDLC"
      },
      {
        "command": "agenticSdlc.resume",
        "title": "Resume projects",
        "category": "Agentic SDLC",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agenticSdlc.approve",
        "title": "Approve",
        "category": "Agentic SDLC",
        "icon": "$(check)"
      },
      {
        "command": "agenticSdlc.reject",
        "title": "Reject",
        "category": "Agentic SDLC",
        "icon": "$(close)"
      },
      {
        "command": "agenticSdlc.approveAllHires",
        "title": "Approve all hires",
        "category": "Agentic SDLC",
        "icon": "$(person-add)"
      },
      {
        "command": "agenticSdlc.refresh",
        "title": "Refresh",
        "category": "Agentic SDLC",
        "icon": "$(refresh)"
      },
      {
        "command": "agenticSdlc.useWorkspace",
        "title": "Show my workspace",
        "category": "Agentic SDLC",
        "icon": "$(root-folder)"
      },
      {
        "command": "agenticSdlc.showRunPanel",
        "title": "Show run panel",
        "category": "Agentic SDLC",
        "icon": "$(preview)"
      },
      {
        "command": "agenticSdlc.openProject",
        "title": "Open project in run panel",
        "category": "Agentic SDLC"
      },
      {
        "command": "agenticSdlc.showDashboard",
        "title": "Company dashboard",
        "category": "Agentic SDLC",
        "icon": "$(dashboard)"
      },
      {
        "command": "agenticSdlc.openReplayPage",
        "title": "Create replay page for stakeholders",
        "category": "Agentic SDLC",
        "icon": "$(export)"
      },
      {
        "command": "agenticSdlc.revealArtifacts",
        "title": "Reveal project artifacts",
        "category": "Agentic SDLC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agenticSdlc.initCompany",
        "title": "Set up company (org chart, budgets, governance)\u2026",
        "category": "Agentic SDLC",
        "icon": "$(organization)"
      },
      {
        "command": "agenticSdlc.setApiKey",
        "title": "Set Anthropic API key",
        "category": "Agentic SDLC"
      },
      {
        "command": "agenticSdlc.clearApiKey",
        "title": "Remove Anthropic API key",
        "category": "Agentic SDLC"
      },
      {
        "command": "agenticSdlc.installDependencies",
        "title": "Install engine dependencies",
        "category": "Agentic SDLC"
      },
      {
        "command": "agenticSdlc.cancel",
        "title": "Cancel current run",
        "category": "Agentic SDLC",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agenticSdlc.buildFromDocument",
          "when": "view == agenticSdlc.projects",
          "group": "navigation@1"
        },
        {
          "command": "agenticSdlc.runRequest",
          "when": "view == agenticSdlc.projects",
          "group": "navigation@2"
        },
        {
          "command": "agenticSdlc.resume",
          "when": "view == agenticSdlc.projects",
          "group": "navigation@3"
        },
        {
          "command": "agenticSdlc.showDashboard",
          "when": "view == agenticSdlc.projects",
          "group": "navigation@4"
        },
        {
          "command": "agenticSdlc.refresh",
          "when": "view == agenticSdlc.projects",
          "group": "navigation@5"
        },
        {
          "command": "agenticSdlc.useWorkspace",
          "when": "view == agenticSdlc.projects",
          "group": "overflow"
        },
        {
          "command": "agenticSdlc.cancel",
          "when": "view == agenticSdlc.projects",
          "group": "overflow"
        },
        {
          "command": "agenticSdlc.approveAllHires",
          "when": "view == agenticSdlc.approvals",
          "group": "navigation@1"
        },
        {
          "command": "agenticSdlc.refresh",
          "when": "view == agenticSdlc.approvals",
          "group": "navigation@2"
        },
        {
          "command": "agenticSdlc.initCompany",
          "when": "view == agenticSdlc.company",
          "group": "navigation@1"
        },
        {
          "command": "agenticSdlc.showDashboard",
          "when": "view == agenticSdlc.company",
          "group": "navigation@2"
        },
        {
          "command": "agenticSdlc.refresh",
          "when": "view == agenticSdlc.stacks",
          "group": "navigation@1"
        },
        {
          "command": "agenticSdlc.checkSetup",
          "when": "view == agenticSdlc.projects",
          "group": "overflow"
        }
      ],
      "view/item/context": [
        {
          "command": "agenticSdlc.approve",
          "when": "view == agenticSdlc.approvals && viewItem == approval.pending",
          "group": "inline@1"
        },
        {
          "command": "agenticSdlc.reject",
          "when": "view == agenticSdlc.approvals && viewItem == approval.pending",
          "group": "inline@2"
        },
        {
          "command": "agenticSdlc.openReplayPage",
          "when": "view == agenticSdlc.projects && viewItem == project.withTrace",
          "group": "inline@1"
        },
        {
          "command": "agenticSdlc.revealArtifacts",
          "when": "view == agenticSdlc.projects && viewItem == project.withTrace",
          "group": "inline@2"
        }
      ],
      "explorer/context": [
        {
          "command": "agenticSdlc.buildFromDocument",
          "when": "resourceExtname =~ /\\.(md|markdown|txt|docx|pdf)$/",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "agenticSdlc.runSelection",
          "when": "editorHasSelection",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "agenticSdlc.buildFromDocument",
          "when": "resourceExtname =~ /\\.(md|markdown|txt)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agenticSdlc.runSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "agenticSdlc.approve",
          "when": "false"
        },
        {
          "command": "agenticSdlc.reject",
          "when": "false"
        },
        {
          "command": "agenticSdlc.openProject",
          "when": "false"
        },
        {
          "command": "agenticSdlc.openReplayPage",
          "when": "false"
        },
        {
          "command": "agenticSdlc.revealArtifacts",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agentic SDLC",
      "properties": {
        "agenticSdlc.agentRuntime": {
          "type": "string",
          "enum": [
            "claudeSubscription",
            "apiKey"
          ],
          "default": "claudeSubscription",
          "enumDescriptions": [
            "Run agents on your Claude Pro/Max/Team/Enterprise plan through Claude Code (signed in with /login). No API key needed; your plan's usage limits apply.",
            "Run agents through the Anthropic API with your API key (billed per token)."
          ],
          "description": "How the agents reach Claude."
        },
        "agenticSdlc.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code CLI ('claude') if it is not on PATH."
        },
        "agenticSdlc.approverName": {
          "type": "string",
          "default": "",
          "description": "Name recorded in the audit trail for your approvals. Empty = OS user name."
        },
        "agenticSdlc.autoResume": {
          "type": "boolean",
          "default": true,
          "description": "Resume the project automatically once nothing is waiting for a decision."
        },
        "agenticSdlc.createGitBranch": {
          "type": "boolean",
          "default": true,
          "description": "Create a branch (agentic/<request>-<time>) before each live run so changes are easy to review or discard."
        },
        "agenticSdlc.maxFixIterations": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 6,
          "description": "How often a failing quality gate is routed back to an agent before escalating to you."
        },
        "agenticSdlc.companyStore": {
          "type": "string",
          "default": "",
          "description": "Path to a shared company database so one company (org chart, budgets, audit) serves many repositories. Empty = per repository (.agentic-sdlc/company.db)."
        },
        "agenticSdlc.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.11+ for the orchestrator. Empty = auto-detect."
        },
        "agenticSdlc.pmdPath": {
          "type": "string",
          "default": "",
          "description": "PMD 7 launcher, used when a Salesforce (Apex) stack is detected and PMD is not on PATH."
        },
        "agenticSdlc.salesforceTargetOrg": {
          "type": "string",
          "default": "",
          "description": "Only for Salesforce stacks: sf CLI alias of a sandbox/scratch org for environment validation. Never production."
        },
        "agenticSdlc.minCoverage": {
          "type": "number",
          "default": 75,
          "description": "Minimum coverage (%) for platform environment validation where the platform reports it (e.g. Apex)."
        }
      }
    }
  },
  "scripts": {
    "sync-engine": "node scripts/sync-engine.js",
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run sync-engine && npm run compile",
    "test": "npm run sync-engine && npm run compile && node test/runner.test.js && node test/extension.smoke.js",
    "test:webview": "node test/webview.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gauravshukla1507/SDLC-AGENT.git"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.9.3"
  }
}
